# ── Sécurité ──────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# ── Base de données ────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///db.sqlite3
# Pour PostgreSQL :
# DATABASE_URL=postgres://user:password@localhost:5432/ecclessia_manager

# ── WebSocket (optionnel) ──────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Email SMTP ─────────────────────────────────────────────────────────────
# En développement : les emails s'affichent dans la console (ne pas changer EMAIL_BACKEND)
# En production : changer EMAIL_BACKEND pour smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre@email.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=Emerge In Christ <no-reply@emergeinchrist.org>

# ── Fichiers média (logos) ─────────────────────────────────────────────────
MEDIA_ROOT=media
