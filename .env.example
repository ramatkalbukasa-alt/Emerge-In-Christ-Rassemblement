# ── Sécurité ──────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# En production (DEBUG=False), HTTPS est forcé automatiquement (redirection,
# cookies sécurisés). HSTS reste désactivé par défaut car onrender.com est un
# domaine partagé : ne définir HSTS_SECONDS qu'une fois un domaine personnalisé
# stable en HTTPS confirmé.
# HSTS_SECONDS=604800

# Administrateur créé une seule fois au déploiement (valeurs à définir sur Render).
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
# Un redéploiement ne modifie pas le mot de passe d'un compte existant.

# ── Base de données ────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///db.sqlite3
# Pour PostgreSQL :
# DATABASE_URL=postgres://user:password@localhost:5432/ecclessia_manager

# ── WebSocket (optionnel) ──────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Email SMTP ─────────────────────────────────────────────────────────────
# En développement : les emails s'affichent dans la console (ne pas changer EMAIL_BACKEND)
# En production : changer EMAIL_BACKEND pour smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre@email.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=Emerge In Christ <no-reply@emergeinchrist.org>

# ── Fichiers média (logos) ─────────────────────────────────────────────────
MEDIA_ROOT=media
